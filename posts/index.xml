    <item>
      <title>使用hugo、Github和Cloudflare免费搭建个人博客</title>
      <link>http://www.buray.top/posts/hugo/</link>
      <pubDate>Tue, 04 Nov 2025 00:00:00 +0000</pubDate><author>buray@qq.com (Buray)</author>
      <guid>http://www.buray.top/posts/hugo/</guid>
      <category domain="http://www.buray.top/categories/%E7%AC%94%E8%AE%B0/">笔记</category>
